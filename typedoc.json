{
	"$schema": "https://typedoc.org/schema.json",
	"out": "./docs",
	"entryPoints": ["./src/index.ts"],
	"plugin": ["typedoc-plugin-markdown"],
	"disableGit": true,
	"intentionallyNotExported": ["EthersFunctionOutput", "EthersEventLog"],
	"sourceLinkTemplate": "https://github.com/evmts/tevm-ethers/blob/main/{path}#L{line}",
	"parametersFormat": "table",
	"propertiesFormat": "table"
}
