{
	"name": "@tevm/ethers",
	"version": "1.0.0-rc.151",
	"private": false,
	"description": "Ethers.js integration for Tevm",
	"keywords": [
		"ethers",
		"solidity",
		"forge",
		"foundry",
		"typescript",
		"web3",
		"blockchain",
		"tevm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm-ethers.git"
	},
	"homepage": "https://ethers.tevm.sh",
	"bugs": {
		"url": "https://github.com/evmts/tevm-ethers/issues"
	},
	"license": "MIT",
	"contributors": [
		"Will Cory <willcory10@gmail.com>"
	],
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"build": "pnpm run build:dist && pnpm run build:types",
		"build:dist": "tsup",
		"build:types": "tsup --dts-only",
		"format": "biome format . --write",
		"docs:dev": "pnpm --filter @tevm/ethers-docs dev",
		"docs:build": "pnpm --filter @tevm/ethers-docs build",
		"docs:preview": "pnpm --filter @tevm/ethers-docs preview",
		"generate:docs": "typedoc",
		"lint": "biome check .",
		"release": "pnpm run build && changeset publish",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "node --test test/e2e/package.test.mjs",
		"test:fuzz": "vitest run .fuzz.spec.ts",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"@tevm/actions": "^1.0.0-next.149",
		"@tevm/client-types": "^1.0.0-next.148",
		"@tevm/common": "^1.0.0-next.148",
		"@tevm/contract": "^1.0.0-next.149",
		"@tevm/decorators": "^1.0.0-next.148",
		"@tevm/node": "^1.0.0-next.148",
		"@tevm/utils": "^1.0.0-next.148"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@tevm/tsconfig": "^1.0.0-next.142",
		"@tevm/tsupconfig": "^1.0.0-next.148",
		"@tevm/tx": "^1.0.0-next.148",
		"@vitest/coverage-v8": "^4.1.10",
		"ethers": "^6.17.0",
		"fast-check": "^4.11.0",
		"tevm": "^1.0.0-next.149",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.14.1",
		"typescript": "^6.0.3",
		"viem": "2.46.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"ethers": ">=6.0.0 <7",
		"tevm": ">=1.0.0-next.149 <2",
		"viem": ">=2.37.9 <=2.46.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": "^24.0.0",
		"pnpm": "^9.0.0"
	}
}
